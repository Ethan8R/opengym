{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path+",
      "destination": "/api/[...path]?__p=:path"
    }
  ]
}
